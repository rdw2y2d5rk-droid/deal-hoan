# Project Settings → API in Supabase. Use the publishable key for new projects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Older Supabase projects may use this instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Shopee Affiliate Open API — primary source for real Shopee product and
# flash-sale data. Create/enable Open API access in https://affiliate.shopee.vn.
# Keep both values server-only: never prefix them with NEXT_PUBLIC_.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Optional only when Shopee provides a different approved API host.
# SHOPEE_API_BASE=https://open-api.affiliate.shopee.vn

# AccessTrade Vietnam — fallback covering Shopee, Lazada and TikTok Shop in one
# feed. Register as a publisher at https://accesstrade.vn.
ACCESSTRADE_TOKEN=
# Optional; defaults to shopee,lazada,tiktokshop
ACCESSTRADE_MERCHANTS=
